# Discord Webhook Configuration
# Get your webhook URL from Discord: Server Settings > Integrations > Webhooks
# Replace the URL below with your actual Discord webhook URL
WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# qBittorrent Discord Webhook (optional)
# Separate webhook URL for qBittorrent notifications (downloads, seeding, status)
# If not set, qBittorrent notifications will not be sent
# Recommended: Create a separate webhook for qBittorrent notifications
QBITTORRENT_WEBHOOK=https://discord.com/api/webhooks/YOUR_QBITTORRENT_WEBHOOK_ID/YOUR_QBITTORRENT_WEBHOOK_TOKEN

# Enable qBittorrent monitoring (true/false)
# Must be set explicitly; default is false (disabled)
QBITTORRENT_MONITOR=false

# Monitoring Thresholds (percentages)
# CPU usage threshold - alerts when CPU usage exceeds this percentage
# Recommended: 75% (catches high usage before system becomes unresponsive)
CPU_THRESHOLD=75.0

# Memory usage threshold - alerts when memory usage exceeds this percentage
# Recommended: 75% (gives time to address before swap usage spikes)
MEMORY_THRESHOLD=75.0

# GPU usage threshold - alerts when GPU utilization exceeds this percentage (NVIDIA GPUs only)
# Recommended: 85% (GPUs can handle higher sustained loads)
GPU_THRESHOLD=85.0

# Disk usage threshold - alerts when disk usage exceeds this percentage
# Recommended: 85% (disks can be fuller before becoming critical)
DISK_THRESHOLD=85.0

# Disk early warning threshold - alerts when disk usage approaches this percentage
# Recommended: 75% (gives advance warning before reaching critical threshold)
DISK_EARLY_WARNING_THRESHOLD=75.0

# Disk cleanup threshold - disk usage percentage that starts automatic cleanup
# Cleanup trims oversized logs and removes aged temp files. Keep this high: cleanup
# is destructive and should not run on a healthy disk.
# Recommended: 85%
DISK_CLEANUP_THRESHOLD=85.0

# Disk aggressive cleanup threshold - usage percentage that allows emptying logs and
# clearing package caches. Only reach for this shortly before the emergency threshold.
# Recommended: 92%
DISK_AGGRESSIVE_CLEANUP_THRESHOLD=92.0

# Disk emergency threshold - usage percentage that triggers emergency cleanup
# Recommended: 95%
DISK_EMERGENCY_THRESHOLD=95.0

# Cleanup path allowlist override (true/false)
# When false, temp cleanup is restricted to /tmp and /var/tmp and cache cleanup to
# /var/cache. Enabling this permits deletion anywhere the process can write.
# Recommended: false
ALLOW_UNSAFE_CLEANUP_PATHS=false

# Monitor individual partitions/drives separately (true/false)
# When enabled, monitors each partition individually, especially NVMe drives
# Recommended: true (enables per-drive monitoring and NVMe-specific alerts)
MONITOR_INDIVIDUAL_PARTITIONS=true

# Temperature threshold - alerts when CPU temperature exceeds this value in Celsius (Linux only)
# Recommended: 75°C (safe operating temperature, adjust based on your CPU's max temp)
TEMP_THRESHOLD=75.0

# Temperature alert duration - seconds that temperature must stay above threshold before alerting
# Recommended: 30.0 seconds (prevents false alarms from brief spikes)
TEMP_ALERT_DURATION=30.0

# Process Resource Thresholds (per-process)
# Process CPU threshold - alerts when any individual process exceeds this CPU usage percentage
# Recommended: 40% (catches processes using significant CPU resources)
PROCESS_CPU_THRESHOLD=40.0

# Process memory threshold - alerts when any individual process exceeds this memory usage percentage
# Recommended: 8% (catches memory-hungry processes before they consume too much)
PROCESS_MEMORY_THRESHOLD=8.0

# Freeze Detection Settings
# Enable freeze detection (true/false) - disabled by default to avoid false positives
FREEZE_MONITOR_ENABLED=false
# Freeze threshold - seconds without metric updates before considering system frozen
FREEZE_THRESHOLD=30.0
# Freeze heartbeat timeout - seconds without heartbeat from monitoring loop before considering frozen
FREEZE_HEARTBEAT_TIMEOUT=60.0

# Directory Monitoring Settings
# Enable media directory monitoring (true/false)
# Default: false (disabled). Set to true to enable size checks and alerts.
MEDIA_MONITOR_ENABLED=false

# Media directory path - directory to monitor for size
# Recommended: /home/media (adjust to your media directory path)
MEDIA_DIRECTORY=/home/media

# Media directory threshold - alert when directory size exceeds this value in GB
# Recommended: 500.0 GB (adjust based on your storage capacity)
MEDIA_DIRECTORY_THRESHOLD_GB=500.0

# Media check interval - check directory size every N loop iterations (to reduce overhead)
# Recommended: 10 (checks every 10 monitoring cycles, reducing I/O load)
MEDIA_CHECK_INTERVAL=10

# Monitoring Settings
# Check interval - seconds between each monitoring check
# Recommended: 5.0 seconds (good balance between responsiveness and system load)
CHECK_INTERVAL=5.0

# Alert cooldown - seconds between alerts for the same metric (prevents spam)
# Recommended: 300 seconds (5 minutes - prevents alert fatigue while still being responsive)
ALERT_COOLDOWN=300.0

# Watchdog Settings
# Monitoring watchdog timeout - seconds without heartbeat before watchdog triggers
# Recommended: 30.0 seconds (detects hangs quickly without false positives)
MONITORING_WATCHDOG_TIMEOUT=30.0

# Watchdog auto-restart - automatically restart service when watchdog detects stop (true/false)
# Only works when running as systemd service
# Recommended: true (enables automatic recovery from crashes)
# Warning: If the service keeps crashing, this will create a restart loop
WATCHDOG_AUTO_RESTART=false

# Watchdog restart cooldown - seconds between restart attempts (prevents restart loops)
# Recommended: 300.0 seconds (5 minutes - allows time for issues to resolve)
WATCHDOG_RESTART_COOLDOWN=300.0

# Systemd Service Installation
# Set to true to install as systemd service on startup (requires sudo)
# Recommended: false (install manually with: sudo python src/main.py --install-systemd)
INSTALL_SYSTEMD=false

# Run startup self-test to verify monitors and send sample embeds (if WEBHOOK set)
# Default: true
SELF_TEST_ON_START=true

# Systemd service name (if installing as service)
# Recommended: server-monitor
SYSTEMD_SERVICE_NAME=server-monitor

# qBittorrent Web UI Configuration
# qBittorrent Web UI host - hostname or IP address where qBittorrent Web UI is running
# Recommended: localhost (or your server IP if accessing remotely)
QBITTORRENT_HOST=localhost

# qBittorrent Web UI port - port number for qBittorrent Web UI
# Recommended: 8080 (default qBittorrent Web UI port)
QBITTORRENT_PORT=8080

# qBittorrent Web UI username - username for qBittorrent Web UI authentication
# Recommended: admin (or your configured username)
QBITTORRENT_USERNAME=admin

# qBittorrent Web UI password - password for qBittorrent Web UI authentication
# Required: Set this to your qBittorrent Web UI password
QBITTORRENT_PASSWORD=

# Stalled torrent handling (download stalls only; idle seeding is ignored)
# Seconds a download must remain stalled before recovery/alert
# Recommended: 300 (5 minutes)
STALLED_TORRENT_THRESHOLD=300

# Minimum seconds between recovery attempts/alerts for the same torrent
# Recommended: 1800 (30 minutes) to avoid spam when peers flap
STALLED_TORRENT_ACTION_COOLDOWN=1800

# Seconds a torrent must stay unstalled before the stall timer resets
# Recommended: 120 (avoids re-alerting on brief peer flicker)
STALLED_TORRENT_RECOVERY_GRACE=120

# Automatically reannounce + resume stalled downloads (true/false)
# Recommended: true
STALLED_TORRENT_AUTO_HANDLE=true

# Seconds to wait before retrying after a failed stalled recovery
# Recommended: 60
STALLED_TORRENT_RETRY_BACKOFF=60

# Seeding ratio handling (always pauses completed seeds at/above the limit)
# Minimum share ratio before a completed torrent is paused
# Set to 0 to disable ratio auto-pause
# Recommended: 1.0
SEEDING_RATIO_LIMIT=1.0

# Minimum seconds between successful ratio-limit pause attempts/alerts for the same torrent
# Recommended: 1800 (30 minutes)
SEEDING_RATIO_ACTION_COOLDOWN=1800

# Seconds to wait before retrying after a failed ratio pause
# Recommended: 60
SEEDING_RATIO_RETRY_BACKOFF=60

# Log Monitoring Settings
# Log threshold - alert when any log file exceeds this size in MB
# Recommended: 100.0 MB (monitors application logs and system logs like syslog, messages, journal)
LOG_THRESHOLD_MB=100.0

# Log auto-clean is always enabled - logs exceeding threshold are automatically cleaned
# Regular log files are truncated to threshold size (keeping most recent data)
# Journal logs are cleaned using journalctl --vacuum-size
# Each log file will only trigger one alert before being cleaned to prevent spam

# Log check interval - check log sizes every N loop iterations (to reduce overhead)
# Recommended: 20 (checks every 20 monitoring cycles, reducing I/O load)
LOG_CHECK_INTERVAL=20

# Rotated log retention - days to keep rotated archives such as syslog.1,
# kern.log.1, syslog.2.gz and syslog-20240115. Nothing writes to these files, so
# they are deleted outright rather than trimmed. Archives are also removed early
# when a single archive exceeds LOG_THRESHOLD_MB, and all of them are removed
# during aggressive/emergency disk cleanup.
# Set to 0 to delete rotated archives as soon as they are found.
# Recommended: 7
ROTATED_LOG_RETENTION_DAYS=7

# Kernel Monitoring Settings
# Ignore I/O errors on specific devices (comma-separated list)
# Useful for devices with known/false positive I/O errors that you want to ignore
# Example: KERNEL_IGNORE_DEVICES=nvme0n1,sda
# Leave empty to monitor all devices
KERNEL_IGNORE_DEVICES=

# Web Dashboard Settings
# Host to bind the dashboard to. 127.0.0.1 keeps it reachable only from this machine.
# Binding to 0.0.0.0 requires WEB_AUTH_TOKEN to be set, otherwise the server refuses
# to start and the dashboard stays offline.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Shared secret required for dashboard and API requests. Clients send it as
# 'Authorization: Bearer <token>' or 'X-Auth-Token: <token>'.
# Leave empty only when WEB_HOST is loopback.
WEB_AUTH_TOKEN=

# Allowed CORS origin for the API. The default blocks cross-origin browser reads;
# set an explicit origin (e.g. https://dash.example.com) only if you need one.
WEB_ALLOWED_ORIGIN=null

# System Update Settings
# Automatic OS package updates are OFF by default. Enabling these lets the monitor
# run package manager upgrades with root/passwordless sudo on a schedule, which can
# restart services and change system state without review.
SYSTEM_UPDATE_ENABLED=false

# Install upgrades rather than only reporting them. Requires SYSTEM_UPDATE_ENABLED.
SYSTEM_UPDATE_APPLY=false

# Seconds between update checks (minimum 300, default 86400)
SYSTEM_UPDATE_INTERVAL_SECONDS=86400

# Per-command timeout for package manager invocations, in seconds
SYSTEM_UPDATE_TIMEOUT=3600

# Application Logging
# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Anything else falls back to INFO.
# Records are written as: <time> - ServerMonitor.<Component> - <LEVEL> - <message>
# Components include Core, Disk, Logs, Discord, Web, Kernel, Watchdog and Security,
# so you can filter one subsystem with e.g. grep 'ServerMonitor.Disk'.
LOG_LEVEL=INFO

# Path to the monitor's own log file. Console logging always stays on; if this path
# is not writable the agent logs to stdout only instead of failing to start.
LOG_FILE=server_monitor.log

# Rotation of the monitor's own log: size per file and how many old files to keep.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Disk usage percentage at which the monitor stops writing its own log file, so it
# cannot be the process that fills the last of the disk. Console logging continues,
# and file logging resumes once usage drops 5 points below this value.
DISK_FULL_THRESHOLD=95.0

LOG_SERVICES_TO_RESTART=rsyslog,systemd-journald

NGINX_LOG_DIR=/var/log/nginx
NGINX_USER_GROUP=www-data:adm
NGINX_SERVICE_NAME=nginx

