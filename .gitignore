nightjar.log
*.log
*.log.*
.env
.env.*
*.db
*.db-wal
*.db-shm
# Build output, made by make, build.sh and deploy-ui.sh; never committed. The two embed folders keep
# only their .gitkeep, so a plain go build still compiles.
bin/
dist/
/web/
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep
backend/internal/agentbin/dist/*
!backend/internal/agentbin/dist/.gitkeep
*.tsbuildinfo
node_modules/
.vite/
coverage/

# Plugins installed on this machine; the examples live in examples/plugins.
/plugins/
# SSH keys Nightjar makes to log in to other servers, private halves included.
/ssh/

# Kernel monitor state (KERNEL_TRACKING_FILE), written while the monitor runs.
.nightjar_kernel_tracking.json

# Screenshots taken while checking the UI by hand; not part of the app.
/frontend/audit/
/frontend/att-*.png
